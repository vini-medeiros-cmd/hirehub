# Site do HireHub.
#
#   sudo cp deploy/hirehub-*.service deploy/hirehub-*.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hirehub-web.service hirehub-coleta.timer
#
# Escuta só em 127.0.0.1: quem fala com a internet é o Nginx (ver nginx.conf),
# que cuida de TLS e compressão. Expor este processo direto na porta 80 seria
# entregar http.server ao mundo — ele não foi feito para isso.

[Unit]
Description=HireHub — site
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hirehub
Group=hirehub
WorkingDirectory=/opt/hirehub

# TROQUE PELO ENDEREÇO REAL desta instalação. Daqui saem as URLs canônicas, o
# sitemap.xml e o robots.txt — errado aqui, os buscadores são instruídos a
# indexar um endereço que não existe.
#
# Sem domínio, o IP serve: http://SEU.IP.AQUI — só lembre de atualizar se o IP
# mudar. Na Oracle, IP "Ephemeral" some junto com a instância; converter para
# "Reserved" (sem custo) evita essa surpresa.
Environment=HIREHUB_URL=http://SEU.IP.AQUI

ExecStart=/usr/bin/python3 /opt/hirehub/bin/servir.py 127.0.0.1 8080
Restart=always
RestartSec=5

# O serviço só lê o banco e serve arquivos. Nada aqui precisa de mais que isso.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hirehub/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
